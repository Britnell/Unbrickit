{
  "name": "unbrickit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:worker": "tsc src/worker.ts --outDir dist --target es2022 --module es2022 --moduleResolution bundler",
    "build:all": "npm run build && npm run build:worker",
    "worker:dev": "npm run build:all && wrangler dev",
    "worker:deploy": "npm run build:all && wrangler deploy",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "wrangler": "^4.140.0"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@preact/signals-core": "^1.14.4",
    "alpinejs": "^3.17.4",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
